{
  "name": "WebHelp",
  "description": "Extensão para alterar cores e textos da página",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": ["activeTab", "scripting"],

  "action": {
    "default_popup": "popup.html",
    "default_title": "WebHelp"
  },

  "commands": {
    "speech-read": {
      "suggested_key": {
        "default": "Alt+L"
      },
      "description": "Ler texto selecionado"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
